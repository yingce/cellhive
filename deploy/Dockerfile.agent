# syntax=docker/dockerfile:1
# Agent-only release: retain the accepted runtime/workerd artifacts unchanged.
ARG RUNTIME_IMAGE=sgccr.ccs.tencentyun.com/vwork/cellhive@sha256:dc68536738177a541c061667ff0bc111912d2bab2d13826ca3d2bb113ddc3f25
FROM golang:1.27-bookworm AS build
WORKDIR /src
ENV CGO_ENABLED=1 CGO_CFLAGS="-O2 -g -DSQLITE_ENABLE_FILESTAT"
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -tags "sqlite_fts5 sqlite_dbstat sqlite_math_functions sqlite_column_metadata sqlite_preupdate_hook" -trimpath -ldflags="-s -w" -o /out/cell-agent ./cmd/cell-agent
FROM ${RUNTIME_IMAGE}
COPY --from=build /out/cell-agent /usr/local/bin/cell-agent
