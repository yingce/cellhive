# syntax=docker/dockerfile:1
# Reproducible builder for the cellhive-workerd fork. Produces a Linux x86-64
# workerd binary on Ubuntu 24.04 (glibc 2.39), matching the runtime image.
#
#   docker build --target artifact --output type=local,dest=deploy/workerd-fork \
#     -f deploy/Dockerfile.workerd-fork-build .
FROM ubuntu:24.04 AS build
ARG WORKERD_FORK_REF=cellhive-v1.20260916.1-3
ARG BAZELISK_VERSION=v1.27.0
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git xz-utils python3 build-essential pkg-config \
      lsb-release wget gnupg software-properties-common tcl \
 && wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh \
 && sed -i '/apt-get install/d' /tmp/llvm.sh && chmod +x /tmp/llvm.sh \
 && /tmp/llvm.sh 19 \
 && apt-get install -y --no-install-recommends \
      clang-19 lld-19 libunwind-19 libc++abi1-19 libc++1-19 libc++-19-dev libclang-rt-19-dev \
 && curl -fsSL "https://github.com/bazelbuild/bazelisk/releases/download/${BAZELISK_VERSION}/bazelisk-linux-amd64" -o /usr/local/bin/bazel \
 && chmod 0755 /usr/local/bin/bazel \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${WORKERD_FORK_REF}" https://github.com/yingce/cellhive-workerd /src
WORKDIR /src
RUN echo "build:linux --repo_env=CC=/usr/lib/llvm-19/bin/clang" >> .bazelrc \
 && bazel build --config=release_linux //src/workerd/server:workerd
FROM scratch AS artifact
COPY --from=build /src/bazel-bin/src/workerd/server/workerd /workerd
