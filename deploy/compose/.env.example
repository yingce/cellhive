# Copy to .env (same directory as docker-compose.yml) before `docker compose up`.
#
# The single platform root key: every role credential is HKDF-derived from it
# (ADR-137), so this is the only secret the stack needs.
#   make:  openssl rand -base64 32
CELLHIVE_ROOT_KEY=

# Optional external bucket. Local filesystem is only safe with one cell-agent.
# For the s3 profile first start minio, create the bucket with bin/s3init,
# and set the endpoint to its in-network address before starting the stack.
# CELLHIVE_BUCKET=s3://cellhive
# AWS_ENDPOINT_URL=http://minio:9000
# AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# With --profile rpo0, route only to the gated DO service:
# CELLHIVE_DO_RUNTIMES=do-runtime-gated:8788

# Container-wide quotas (Go host/supervisor + workerd). CPU is a rate quota,
# not cpuMs per invocation; memory includes every resident Worker in the container.
# Equal memory and memory+swap limits disable container swap.
CELLHIVE_USER_RUNTIME_CPUS=1.0
CELLHIVE_USER_RUNTIME_MEMORY=2g
CELLHIVE_DO_RUNTIME_CPUS=2.0
CELLHIVE_DO_RUNTIME_MEMORY=4g

# Opt-in experimental Go-managed user-runtime pool. Leave empty for the
# proven single-workerd path until the pool E2E gate is accepted.
# CELLHIVE_POOL_MODE=adaptive
# CELLHIVE_POOL_MEMORY_UTILIZATION=0.70
# CELLHIVE_POOL_MAX_SLOTS=16
